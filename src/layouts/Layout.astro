---
// Fuentes autoalojadas (Poppins display + DM Sans UI): sin llamadas a Google,
// coherente con el principio de privacidad (nada sale del navegador).
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;

const description =
  'Diagnóstico Adapsys de madurez en gobernanza y protección de datos: mide la preparación de tu institución frente a la Ley 21.719 y el Marco de Gestión de Datos del Estado (MGDE), con plan de acción y hoja de ruta.';
const site = Astro.site ?? new URL('https://adapsys-gobierno-datos.vercel.app');
const base = import.meta.env.BASE_URL.replace(/\/$/, ''); // base sin barra final
const ogImage = new URL(`${base}/portada.png`, site).href;
const canonical = new URL(`${base}/`, site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2456c4" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Herramienta de consultoría en preparación: sin indexar hasta su lanzamiento. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>

    {/* Open Graph / Twitter — vista previa al compartir el enlace */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Adapsys · Diagnóstico de Gobernanza de Datos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Diagnóstico Adapsys de madurez en gobernanza de datos — Ley 21.719 + MGDE" />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* Aplica el tema guardado antes de pintar para evitar parpadeo. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('autoeval-madurez-v1-tema');
        if (t) document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
